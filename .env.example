# Empty for root deployment, or a subdirectory such as /SEQSI_PCB_Library.
NEXT_PUBLIC_BASE_PATH=
# Set to the production origin for absolute OpenGraph URLs, e.g. https://example.org
NEXT_PUBLIC_SITE_URL=

# Exact browser origin, without a path. Required for admin writes in production.
APP_ORIGIN=http://localhost:3000
# Persistent PRIVATE directory, outside public/, .next/ and out/. Default: ./var/pcb
PCB_DATA_DIR=./var/pcb
# Single administrator. There is no public signup or default password.
ADMIN_USERNAME=admin
# Generate with npm run admin:password and paste the complete scrypt hash.
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
